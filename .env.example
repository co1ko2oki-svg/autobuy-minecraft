# ================================================================
#             MẪU FILE CẤU HÌNH .ENV - THẬP CẨM STORE
#       (Copy file này thành .env và điền các thông số của bạn)
# ================================================================

# ----------------------------------------------------------------
# 1. CẤU HÌNH DISCORD BOT (BẮT BUỘC)
# ----------------------------------------------------------------
DISCORD_TOKEN=dien_bot_token_vao_day
CLIENT_ID=dien_application_id_vao_day
GUILD_ID=dien_server_id_vao_day
ADMIN_IDS=id_admin_1,id_admin_2

# ----------------------------------------------------------------
# 2. CẤU HÌNH DANH MỤC & KÊNH DISCORD (BẮT BUỘC)
# ----------------------------------------------------------------
# Danh mục chứa các kênh bán tài khoản (Stock)
STOCK_CATEGORY_ID=dien_id_category_stock

# Danh mục tạo các kênh giao dịch riêng (Ticket)
TICKET_CATEGORY_ID=dien_id_category_ticket

# Kênh lưu trữ log bill hóa đơn sau khi khách thanh toán thành công
LOG_CHANNEL_ID=dien_id_kenh_log_bill

# Kênh nhập hàng tự động (Admin gửi tin nhắn hoặc upload file .txt)
INPUT_CHANNEL_ID=dien_id_kenh_nhap_hang

# Kênh khách hàng đăng vouch / +1 legit (Tự động đóng ticket sau khi vouch)
LEGIT_CHANNEL_ID=dien_id_kenh_legit

# Kênh bảng xếp hạng đại gia mua hàng (Tùy chọn)
LEADERBOARD_CHANNEL_ID=dien_id_kenh_bxh

# ----------------------------------------------------------------
# 3. HỆ THỐNG VAI TRÒ / ROLES (TỰ ĐỘNG CẤP KHI MUA HÀNG)
# ----------------------------------------------------------------
BUYER_ROLE_ID=id_role_khach_hang
PING_ROLE_ID=id_role_ping_hang_moi
ROLE_100K_ID=id_role_bac_100k
ROLE_500K_ID=id_role_vang_500k
ROLE_VIP_ID=id_role_vip_1m

# ----------------------------------------------------------------
# 4. CỔNG THANH TOÁN 1: NGÂN HÀNG & SEPAY (TỰ ĐỘNG DUYỆT BANK)
# ----------------------------------------------------------------
BANK_ID=MBbank
BANK_ACCOUNT_NUMBER=0982xxxxxx
BANK_ACCOUNT_NAME=NGUYEN VAN A
SEPAY_API_KEY=dien_sepay_api_key_vao_day
INVOICE_TIMEOUT_MINUTES=10

# ----------------------------------------------------------------
# 5. CỔNG THANH TOÁN 2: PAYOS (TÙY CHỌN - CHẠY SONG SONG VỚI SEPAY)
# Lấy tại https://payos.vn/ (Để trống nếu không dùng)
# ----------------------------------------------------------------
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# ----------------------------------------------------------------
# 6. CỔNG THANH TOÁN 3: THẺ CÀO CARD9S (TÙY CHỌN)
# Lấy tại https://card9s.com/
# ----------------------------------------------------------------
CARD9S_PARTNER_ID=
CARD9S_PARTNER_KEY=
CARD9S_API_URL=https://card9s.com/chargingws/v2

# ----------------------------------------------------------------
# 7. MINECRAFT API & THỐNG KÊ (TÙY CHỌN)
# ----------------------------------------------------------------
HYPIXEL_API_KEY=
DONUT_API_KEY=
MAIN_SERVER_INVITE=https://discord.gg/your_invite
LEADERBOARD_BANNER_URL=
